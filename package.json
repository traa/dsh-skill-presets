{
  "name": "dsh-skill-presets",
  "version": "0.1.0",
  "description": "Out-of-tree DeepSeek Harness plugin: SDLC-stage skill presets, a versioned skill library, practice guardrails, and skill-usage insight. Provider-neutral.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/host/index.js",
  "types": "./lib/host/index.d.ts",
  "files": [
    "lib",
    "src",
    "skills",
    "templates",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "tsdown.client.config.ts",
    "stage"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown -c tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "pretest": "npm run build",
    "clean": "rm -rf lib",
    "build:client": "tsdown -c tsdown.client.config.ts",
    "gen:examples": "node lib/bin/gen-examples.js",
    "stage": "node stage/server.mjs",
    "stage:fixtures": "node stage/gen-fixtures.mjs",
    "test:ui": "playwright test"
  },
  "bin": {
    "dsh-skill-presets": "./lib/bin/cli.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
