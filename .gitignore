node_modules/

# Build output is NOT committed: it is generated by `npm run build`
# (tsc -> lib/ + tsdown -> lib/client.js). Committing it means every source
# change needs a matching rebuild in the same commit or the repo ships a
# stale artifact. Same convention as dsh-workbench and dsh-knowledge.
lib/

tsconfig.tsbuildinfo
*.log
.DS_Store
node_modules

